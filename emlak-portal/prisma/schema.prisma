generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id         Int        @id @default(autoincrement())
  name       String
  properties Property[]
}

model Agent {
  id         Int        @id @default(autoincrement())
  name       String
  phone      String
  properties Property[]
}

model Property {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  title       String
  description String
  price       Float
  type        String
  city        String
  district    String
  bedrooms    Int
  bathrooms   Int
  area        Int
  floor       String?
  imageUrl    String?
  images      String[]  @default([])
  status      String    @default("AKTIF")
  isFeatured  Boolean   @default(false)

  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])

  agentId     Int?
  agent       Agent?    @relation(fields: [agentId], references: [id])
}